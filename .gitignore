/FMOD_2024/.unsaved/

# Claude Code の個人設定
/.claude/settings.local.json

# Python の実行時ファイル
__pycache__/
*.pyc

# IDE・OS が作るもの
.vs/
.idea/
.vscode/
.DS_Store
Thumbs.db
